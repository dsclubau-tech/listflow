DATABASE_URL="your-neon-postgres-connection-string-here"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-railway-app-url.up.railway.app"
AUTH_TRUST_HOST=true

# eBay API config
EBAY_ENVIRONMENT="production"

# eBay developer account (same for all stores)
EBAY_APP_ID="your-ebay-app-id"
EBAY_DEV_ID="your-ebay-dev-id"
EBAY_CERT_ID="your-ebay-cert-id"

# User tokens — one per store
EBAY_STORE1_TOKEN="your-store1-token"
EBAY_STORE2_TOKEN="your-store2-token"
EBAY_STORE3_TOKEN="your-store3-token"
