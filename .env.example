# Supabase Postgres
# Use the Supabase pooler/session connection string for the running app.
DATABASE_URL="postgresql://prisma_user:[PASSWORD]@[POOLER_HOST]:5432/postgres?sslmode=require"

# Optional but recommended for migrations. Use the Supabase direct database URL.
DIRECT_URL="postgresql://prisma_user:[PASSWORD]@[DIRECT_HOST]:5432/postgres?sslmode=require"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Store seed passwords. Change these before seeding production.
STORE_BOOTSTRAP_PASSWORD="change-this-before-production"
STORE_DEFAULT_PASSWORD="change-this-before-production"
STORE_1_PASSWORD=""
STORE_2_PASSWORD=""
STORE_3_PASSWORD=""

# eBay API config
EBAY_ENVIRONMENT="production"

# eBay developer account credentials
EBAY_APP_ID="your-ebay-app-id"
EBAY_DEV_ID="your-ebay-dev-id"
EBAY_CERT_ID="your-ebay-cert-id"

# eBay user tokens, one per store
EBAY_STORE1_TOKEN="your-store1-token"
EBAY_STORE2_TOKEN="your-store2-token"
EBAY_STORE3_TOKEN="your-store3-token"

# Cron auth for protected local/hosted scheduled calls
CRON_SECRET="your-random-secret-here"
