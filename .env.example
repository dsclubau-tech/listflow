# Supabase Postgres
# Use the Supabase pooler connection string for the running app.
# On Vercel, ListFlow automatically changes Supabase pooler port 5432 to
# transaction pooler port 6543 unless LISTFLOW_SUPABASE_TRANSACTION_POOLER=false.
DATABASE_URL="postgresql://prisma_user:[PASSWORD]@[POOLER_HOST]:5432/postgres?sslmode=require"
LISTFLOW_DB_POOL_MAX=1
LISTFLOW_SUPABASE_TRANSACTION_POOLER=true

# Optional but recommended for migrations. Use the Supabase direct database URL.
DIRECT_URL="postgresql://prisma_user:[PASSWORD]@[DIRECT_HOST]:5432/postgres?sslmode=require"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
LISTFLOW_PUBLIC_IMAGE_BASE_URL="https://your-listflow-domain.example"
AUTH_TRUST_HOST=true

# Login protection uses a 15-minute rolling window. It limits failures for one
# store/IP pair, one store across IPs, and one IP across store IDs.

# Store seed passwords. Change these before seeding production.
STORE_BOOTSTRAP_PASSWORD="change-this-before-production"
STORE_DEFAULT_PASSWORD="change-this-before-production"
STORE_1_PASSWORD=""
STORE_2_PASSWORD=""
STORE_3_PASSWORD=""

# Optional authenticated Playwright tests. Use a non-production store with sample drafts.
LISTFLOW_E2E_STORE_ID=""
LISTFLOW_E2E_STORE_PASSWORD=""
# Leave blank to let Playwright start the local Next.js development server.
LISTFLOW_E2E_BASE_URL=""

# eBay API config
EBAY_ENVIRONMENT="production"
LISTFLOW_EBAY_MEDIA_MIN_INTERVAL_MS="1000"

# eBay developer account credentials
EBAY_APP_ID="your-ebay-app-id"
EBAY_DEV_ID="your-ebay-dev-id"
EBAY_CERT_ID="your-ebay-cert-id"

# eBay user tokens, one per store
EBAY_STORE1_TOKEN="your-store1-token"
EBAY_STORE2_TOKEN="your-store2-token"
EBAY_STORE3_TOKEN="your-store3-token"

# Cron auth for protected local/hosted scheduled calls
CRON_SECRET="your-random-secret-here"

# Manual worker (PC 1)
# Optional. Leave unset to process every active store from the worker PC.
# Set to one or more store login IDs/DB IDs separated by commas to restrict the worker.
LISTFLOW_WORKER_STORE_LOGIN_ID=""
LISTFLOW_WORKER_NAME="PC 1 manual worker"
LISTFLOW_WORKER_IDLE_SLEEP_MS="1000"
LISTFLOW_WORKER_ERROR_SLEEP_MS="30000"
LISTFLOW_WORKER_LEASE_TTL_MS="90000"
LISTFLOW_PRICE_CHECK_PRODUCT_DELAY_MIN_MS="1500"
LISTFLOW_PRICE_CHECK_PRODUCT_DELAY_MAX_MS="3500"
LISTFLOW_EBAY_TRADING_MIN_INTERVAL_MS="2500"
LISTFLOW_EBAY_BROWSE_MIN_INTERVAL_MS="10000"
LISTFLOW_EBAY_RATE_LIMIT_BACKOFF_MS="300000"
