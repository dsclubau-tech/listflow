// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]
  uploadLogs UploadLog[]
}

// --- Part 2 Models ---

model Store {
  id          String    @id @default(cuid())
  name        String
  ebayToken   String?
  ebayUserId  String?
  ebayStoreId String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
  uploadLogs  UploadLog[]
  policyTemplates PolicyTemplate[]
}

enum ProductStatus {
  DRAFT
  IMPORTED
  FAILED
}

enum VariantStatus {
  IN_STOCK
  OUT_OF_STOCK
}

enum PriceCheckSource {
  LIVE
  SIMULATED
}

model Product {
  id            String        @id @default(cuid())
  title         String
  description   String        @db.Text
  price         Decimal       @db.Decimal(10, 2)
  quantity      Int           @default(1)
  category      String
  categoryName  String?
  condition     String        @default("New")
  images        String[]
  itemSpecifics Json          @default("{}")
  status        ProductStatus @default(DRAFT)
  ebayItemId    String?
  errorMessage  String?       @db.Text
  asin          String?
  amazonPrice   Decimal?      @db.Decimal(10, 2)
  lastPriceCheck DateTime?
  priceCheckError String?     @db.Text
  shippingPolicyId String?
  returnPolicyId   String?
  paymentPolicyId  String?
  policyTemplateId String?
  templateId       String?
  storeId       String
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  store         Store         @relation(fields: [storeId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])
  uploadLogs    UploadLog[]
  variants      Variant[]
  priceHistory  PriceHistory[]
}

model Variant {
  id               String        @id @default(cuid())
  sku              String?
  title            String
  images           String[]
  buyPrice         Decimal       @db.Decimal(10, 2)
  feesPercent      Float         @default(0)
  feesFixed        Float         @default(0)
  profitPercent    Float         @default(0)
  profitFixed      Float         @default(0)
  sellPrice        Decimal       @db.Decimal(10, 2)
  quantity         Int           @default(1)
  status           VariantStatus @default(IN_STOCK)
  automation       String?
  includeShipping  Boolean       @default(true)
  allowMarketplace Boolean       @default(true)
  roundCents       Float?
  itemSpecifics    Json          @default("{}")
  productId        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceHistory PriceHistory[]

  @@index([productId])
}

model PriceHistory {
  id                String   @id @default(cuid())
  productId         String
  variantId         String?
  previousPrice     Decimal  @db.Decimal(10, 2)
  newPrice          Decimal  @db.Decimal(10, 2)
  previousSellPrice Decimal  @db.Decimal(10, 2)
  newSellPrice      Decimal  @db.Decimal(10, 2)
  changePercent     Float
  ebayRevised       Boolean  @default(false)
  errorMessage      String?  @db.Text
  source            PriceCheckSource @default(LIVE)
  appliedAt         DateTime?
  createdAt         DateTime @default(now())

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
}

enum UploadStatus {
  SUCCESS
  FAILED
}

model UploadLog {
  id           String       @id @default(cuid())
  productId    String
  storeId      String
  userId       String
  status       UploadStatus
  ebayItemId   String?
  errorMessage String?      @db.Text
  createdAt    DateTime     @default(now())

  product      Product      @relation(fields: [productId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
}

// TODO: Part 3

model DescriptionTemplate {
  id        String   @id @default(cuid())
  name      String
  content   String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PolicyTemplate {
  id               String   @id @default(cuid())
  name             String
  storeId          String
  shippingPolicyId String?
  returnPolicyId   String?
  paymentPolicyId  String?
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model KeywordBlacklist {
  id                     String   @id @default(cuid())
  keyword                String
  removeFromTitle        Boolean  @default(false)
  removeFromDescription  Boolean  @default(true)
  createdAt              DateTime @default(now())
}

model SupplierSettings {
  id                    String   @id @default(cuid())
  supplierName          String   @unique @default("Amazon AU")

  defaultQuantity       Int      @default(1)
  defaultCountry        String   @default("Australia")
  defaultZipcode        String   @default("3170")
  defaultShippingMethod String   @default("Cheapest with tracking")
  defaultTemplateId     String?

  defaultShippingPolicyId String?
  defaultPaymentPolicyId  String?
  defaultReturnPolicyId   String?

  ebayFeePercent        Float    @default(13.0)
  fixedFeeAmount        Float    @default(0.33)
  additionalProfitPercent Float  @default(0)
  additionalProfitFixed   Float  @default(0)
  minimumProfit         Float    @default(1.0)

  capitalizeTitle       Boolean  @default(false)
  autofillBrand         Boolean  @default(true)
  allowVeroKeywords     Boolean  @default(false)
  privateListing        Boolean  @default(false)

  defaultWeightUnit     String   @default("Kg")
  automaticSkuFilling   Boolean  @default(true)
  minProductQuantity    Int      @default(2)
  maxShippingDays       Int      @default(25)
  primeOnly             Boolean  @default(true)
  priceTrackingEnabled  Boolean  @default(false)
  priceCheckHour        Int      @default(6)
  scrapePostcode        String   @default("2217")

  storeNumber           Int      @default(1)

  defaultItemSpecifics  Json     @default("{}")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
