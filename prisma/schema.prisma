// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products            Product[]
  uploadLogs          UploadLog[]
  priceCheckJobs      PriceCheckJob[]
  ebayImportJobs      EbayImportJob[]
  ebayResearchJobs    EbayResearchJob[]
  ebayResearchBatches EbayResearchBatch[]
  ebayActionJobs      EbayActionJob[]
}

// --- Part 2 Models ---

model Store {
  id          String    @id @default(cuid())
  name        String
  loginId     String?   @unique
  password    String?
  ebayToken   String?
  ebayUserId  String?
  ebayStoreId String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products             Product[]
  uploadLogs           UploadLog[]
  policyTemplates      PolicyTemplate[]
  ebayImportStatsCache EbayImportStatsCache?
  ebayImportJobs       EbayImportJob[]
  priceCheckJobs       PriceCheckJob[]
  ebayResearchJobs     EbayResearchJob[]
  ebayResearchBatches  EbayResearchBatch[]
  ebayActionJobs       EbayActionJob[]
  descriptionTemplates DescriptionTemplate[]
  keywordBlacklist     KeywordBlacklist[]
  supplierSettings     SupplierSettings[]
  workerHeartbeats     WorkerHeartbeat[]
  jobLeases            JobLease[]
  ebayRateLimitBuckets EbayRateLimitBucket[]
  appLogs              AppLog[]
}

enum ProductStatus {
  DRAFT
  IMPORTED
  FAILED
  ON_HOLD
}

enum VariantStatus {
  IN_STOCK
  OUT_OF_STOCK
}

enum PriceCheckSource {
  LIVE
  SIMULATED
}

enum PriceCheckJobStatus {
  QUEUED
  RUNNING
  CANCELLING
  CANCELLED
  COMPLETED
  FAILED
}

enum PriceCheckJobScope {
  SELECTED
  ALL
}

enum EbayImportJobStatus {
  QUEUED
  RUNNING
  PAUSING
  PAUSED
  CANCELLING
  CANCELLED
  COMPLETED
  FAILED
}

enum EbayResearchJobStatus {
  QUEUED
  RUNNING
  PAUSING
  PAUSED
  COMPLETED
  PARTIAL
  FAILED
}

enum EbayResearchMode {
  ACTIVE
  SOLD
  BOTH
}

enum EbayResearchConditionFilter {
  ANY
  NEW
  USED
  NEW_OTHER
  REFURBISHED
  PARTS_NOT_WORKING
}

enum EbayResearchBatchStatus {
  QUEUED
  RUNNING
  PAUSING
  PAUSED
  COMPLETED
  PARTIAL
  FAILED
}

enum EbayActionJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum EbayActionJobType {
  HOLD
  RESUME
  END
  BULK_EDIT_REVISE
}

enum PromotedAdStatus {
  UNKNOWN
  PROMOTED
  NOT_PROMOTED
}

enum PromotedAdRateStrategy {
  UNKNOWN
  FIXED
  DYNAMIC
}

model Product {
  id            String        @id @default(cuid())
  title         String
  description   String        @db.Text
  price         Decimal       @db.Decimal(10, 2)
  quantity      Int           @default(1)
  category      String
  categoryName  String?
  condition     String        @default("New")
  images        String[]
  itemSpecifics Json          @default("{}")
  status        ProductStatus @default(DRAFT)
  ebayItemId    String?
  errorMessage  String?       @db.Text
  asin          String?
  amazonPrice   Decimal?      @db.Decimal(10, 2)
  amazonStockLeft Int?
  promotedAdPercent Float      @default(0)
  promotedAdStatus PromotedAdStatus @default(UNKNOWN)
  promotedAdCampaignId String?
  promotedAdCampaignName String?
  promotedAdRateStrategy PromotedAdRateStrategy @default(UNKNOWN)
  promotedAdSyncedAt DateTime?
  lastPriceCheck DateTime?
  priceCheckError String?     @db.Text
  internalNote    String?     @db.Text
  shippingPolicyId String?
  returnPolicyId   String?
  paymentPolicyId  String?
  policyTemplateId String?
  templateId       String?
  storeId       String
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  store         Store         @relation(fields: [storeId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])
  uploadLogs    UploadLog[]
  variants      Variant[]
  priceHistory  PriceHistory[]

  @@index([storeId, status])
  @@index([storeId, asin])
  @@index([storeId, ebayItemId])
  @@index([storeId, promotedAdStatus])
  @@index([storeId, promotedAdPercent])
  @@index([storeId, createdAt])
  @@index([storeId, updatedAt])
  @@index([createdById])
}

model Variant {
  id               String        @id @default(cuid())
  sku              String?
  title            String
  images           String[]
  buyPrice         Decimal       @db.Decimal(10, 2)
  feesPercent      Float         @default(0)
  feesFixed        Float         @default(0)
  profitPercent    Float         @default(0)
  profitFixed      Float         @default(0)
  promotedAdPercent Float         @default(0)
  sellPrice        Decimal       @db.Decimal(10, 2)
  quantity         Int           @default(1)
  status           VariantStatus @default(IN_STOCK)
  automation       String?
  includeShipping  Boolean       @default(true)
  allowMarketplace Boolean       @default(true)
  roundCents       Float?
  itemSpecifics    Json          @default("{}")
  productId        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceHistory PriceHistory[]

  @@index([productId])
}

model PriceHistory {
  id                String   @id @default(cuid())
  productId         String
  variantId         String?
  previousPrice     Decimal  @db.Decimal(10, 2)
  newPrice          Decimal  @db.Decimal(10, 2)
  previousSellPrice Decimal  @db.Decimal(10, 2)
  newSellPrice      Decimal  @db.Decimal(10, 2)
  changePercent     Float
  ebayRevised       Boolean  @default(false)
  errorMessage      String?  @db.Text
  source            PriceCheckSource @default(LIVE)
  appliedAt         DateTime?
  createdAt         DateTime @default(now())

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
}

model PriceCheckJob {
  id            String              @id @default(cuid())
  userId        String
  storeId       String?
  scope         PriceCheckJobScope
  status        PriceCheckJobStatus @default(QUEUED)
  productIds    String[]            @default([])
  completedProductIds String[]       @default([])
  total         Int                 @default(0)
  checked       Int                 @default(0)
  changed       Int                 @default(0)
  pendingReview Int                 @default(0)
  failed        Int                 @default(0)
  skipped       Int                 @default(0)
  reason        String?             @db.Text
  errorMessage  String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  startedAt     DateTime?
  completedAt   DateTime?
  dismissedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([storeId, status])
  @@index([createdAt])
  @@index([dismissedAt])
}

enum UploadStatus {
  SUCCESS
  FAILED
}

model UploadLog {
  id           String       @id @default(cuid())
  productId    String
  storeId      String
  userId       String
  status       UploadStatus
  ebayItemId   String?
  errorMessage String?      @db.Text
  createdAt    DateTime     @default(now())

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([storeId, createdAt])
  @@index([userId])
}

model EbayImportStatsCache {
  id             String   @id @default(cuid())
  storeId        String   @unique
  activeListings Int
  listingIds     String[] @default([])
  fetchedAt      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([fetchedAt])
}

model EbayImportJob {
  id                    String              @id @default(cuid())
  userId                String
  storeId               String
  storeNumber           Int
  status                EbayImportJobStatus @default(QUEUED)
  quantity              Int
  requested             Int                 @default(0)
  activeListings        Int                 @default(0)
  alreadyImported       Int                 @default(0)
  remainingBeforeImport Int                 @default(0)
  remainingAfterImport  Int                 @default(0)
  processed             Int                 @default(0)
  total                 Int                 @default(0)
  created               Int                 @default(0)
  skipped               Int                 @default(0)
  failed                Int                 @default(0)
  selectedListingIds    String[]            @default([])
  completedListingIds   String[]            @default([])
  rateLimited           Boolean             @default(false)
  errors                Json                @default("[]")
  errorMessage          String?             @db.Text
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  startedAt             DateTime?
  completedAt           DateTime?
  pausedAt              DateTime?
  cancelledAt           DateTime?
  dismissedAt           DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([storeId, status])
  @@index([createdAt])
  @@index([dismissedAt])
}

model EbayResearchJob {
  id             String                @id @default(cuid())
  userId         String
  storeId        String
  batchId        String?
  status         EbayResearchJobStatus @default(QUEUED)
  mode           EbayResearchMode
  conditionFilter EbayResearchConditionFilter @default(ANY)
  query          String
  limit          Int                   @default(50)
  activeCount    Int                   @default(0)
  soldCount      Int                   @default(0)
  activeSummary  Json                  @default("{}")
  soldSummary    Json                  @default("{}")
  activeResults  Json                  @default("[]")
  soldResults    Json                  @default("[]")
  warningMessage String?               @db.Text
  errorMessage   String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  expiresAt      DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  batch EbayResearchBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([storeId, expiresAt])
  @@index([createdAt])
  @@index([expiresAt])
}

model EbayResearchBatch {
  id          String                  @id @default(cuid())
  userId      String
  storeId     String
  status      EbayResearchBatchStatus @default(QUEUED)
  total       Int                     @default(0)
  completed   Int                     @default(0)
  failed      Int                     @default(0)
  cooldownUntil DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  startedAt   DateTime?
  completedAt DateTime?
  pausedAt    DateTime?
  expiresAt   DateTime?

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  jobs  EbayResearchJob[]

  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([storeId, expiresAt])
  @@index([createdAt])
  @@index([expiresAt])
}

model EbayActionJob {
  id                  String              @id @default(cuid())
  userId              String
  storeId             String
  type                EbayActionJobType
  status              EbayActionJobStatus @default(QUEUED)
  productIds          String[]            @default([])
  completedProductIds String[]            @default([])
  total               Int                 @default(0)
  processed           Int                 @default(0)
  succeeded           Int                 @default(0)
  failed              Int                 @default(0)
  errors              Json                @default("[]")
  metadata            Json                @default("{}")
  errorMessage        String?             @db.Text
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  startedAt           DateTime?
  completedAt         DateTime?
  dismissedAt         DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([dismissedAt])
}

model WorkerHeartbeat {
  id         String   @id @default(cuid())
  storeId    String
  workerId   String
  workerName String
  status     String   @default("ONLINE")
  lastSeenAt DateTime @default(now())
  startedAt  DateTime @default(now())
  version    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, workerId])
  @@index([storeId, lastSeenAt])
  @@index([lastSeenAt])
}

model JobLease {
  id          String   @id @default(cuid())
  storeId     String
  resourceKey String
  jobType     String
  jobId       String
  workerId    String
  workerName  String
  details     Json     @default("{}")
  acquiredAt  DateTime @default(now())
  renewedAt   DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, resourceKey])
  @@index([storeId, jobType, jobId])
  @@index([storeId, workerId])
  @@index([expiresAt])
}

model EbayRateLimitBucket {
  id            String   @id @default(cuid())
  storeId       String
  apiKind       String
  nextAllowedAt DateTime @default(now())
  blockedUntil  DateTime?
  lastError     String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, apiKind])
  @@index([storeId, nextAllowedAt])
  @@index([blockedUntil])
}

model AppLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  level       String
  source      String
  runtime     String
  environment String?

  context     String
  message     String   @db.Text
  fingerprint String
  requestId   String?
  traceId     String?
  pathname    String?
  route       String?
  method      String?
  statusCode  Int?
  durationMs  Int?

  userId     String?
  storeId    String?
  workerId   String?
  workerName String?

  jobType    String?
  jobId      String?
  productId  String?
  variantId  String?
  ebayItemId String?
  asin       String?

  errorName    String?
  errorMessage String? @db.Text
  stack        String? @db.Text

  tags     String[] @default([])
  metadata Json     @default("{}")

  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([storeId, createdAt])
  @@index([level, createdAt])
  @@index([source, createdAt])
  @@index([context])
  @@index([fingerprint])
  @@index([requestId])
  @@index([jobId, createdAt])
  @@index([productId, createdAt])
  @@index([ebayItemId, createdAt])
  @@index([workerId, createdAt])
}

// TODO: Part 3

model DescriptionTemplate {
  id        String   @id @default(cuid())
  storeId   String?
  name      String
  content   String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model PolicyTemplate {
  id               String   @id @default(cuid())
  name             String
  storeId          String
  shippingPolicyId String?
  returnPolicyId   String?
  paymentPolicyId  String?
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model KeywordBlacklist {
  id                     String   @id @default(cuid())
  storeId                String?
  keyword                String
  removeFromTitle        Boolean  @default(false)
  removeFromDescription  Boolean  @default(true)
  createdAt              DateTime @default(now())

  store                  Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model SupplierSettings {
  id                    String   @id @default(cuid())
  storeId               String?
  supplierName          String   @default("Amazon AU")

  defaultQuantity       Int      @default(1)
  defaultCountry        String   @default("Australia")
  defaultZipcode        String   @default("3170")
  defaultShippingMethod String   @default("Cheapest with tracking")
  defaultTemplateId     String?

  defaultShippingPolicyId String?
  defaultPaymentPolicyId  String?
  defaultReturnPolicyId   String?

  ebayFeePercent        Float    @default(13.0)
  fixedFeeAmount        Float    @default(0.33)
  additionalProfitPercent Float  @default(0)
  additionalProfitFixed   Float  @default(0)
  minimumProfit         Float    @default(1.0)

  capitalizeTitle       Boolean  @default(false)
  autofillBrand         Boolean  @default(true)
  allowVeroKeywords     Boolean  @default(false)
  privateListing        Boolean  @default(false)

  defaultWeightUnit     String   @default("Kg")
  automaticSkuFilling   Boolean  @default(true)
  minProductQuantity    Int      @default(2)
  maxShippingDays       Int      @default(25)
  primeOnly             Boolean  @default(true)
  priceTrackingEnabled  Boolean  @default(false)
  priceCheckHour        Int      @default(6)
  scrapePostcode        String   @default("2217")

  storeNumber           Int      @default(1)

  defaultItemSpecifics  Json     @default("{}")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  store                 Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, supplierName])
  @@index([storeId])
}
