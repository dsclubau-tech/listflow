{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.worker",
    "watchPatterns": [
      "/app/**",
      "/lib/**",
      "/prisma/**",
      "/scripts/**",
      "/types/**",
      "/package.json",
      "/package-lock.json",
      "/prisma.config.ts",
      "/tsconfig.json",
      "/Dockerfile.worker",
      "/railway.worker.json"
    ]
  },
  "deploy": {
    "startCommand": "node --import tsx scripts/listflow-worker.ts",
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": 0,
    "drainingSeconds": 300
  }
}
